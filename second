architecture x86_64

rule package {
    die "{@} Isn't installed. But was defined into the Sake as a `package`."
        "Try to install using:\n~> eg. sudo pacman -S {@}"
}

x86_64::linux {
    dependencies {
        when $os -eq "x86_64-linux" {
            as  => package
            ld  => package
            rafael => package
        }
    }

    runner binary {
        when $os -eq "x86_64-linux" {
            log "Building for x86_64 [LINUX]..."

            `as {file} -o {object}`
            `ld {object} -o {elf}`
        }

        log "Build finished!"
    }
}
